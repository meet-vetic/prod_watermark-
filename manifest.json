{
  "manifest_version": 3,
  "name": "Prod Guard – Environment Watermark",
  "short_name": "Prod Guard",
  "version": "1.1.0",
  "description": "Stamps a bold watermark across production sites you choose, so you never mistake prod for staging.",
  "permissions": ["storage", "activeTab"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Prod Guard",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
